# Text files use LF in the repo and in the working tree (Windows scripts below keep CRLF)
* text=auto eol=lf

# Scripts that must keep specific endings
*.sh  text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets (never diff/merge as text)
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.tif  binary
*.tiff binary
*.icc  binary
*.icm  binary
